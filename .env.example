# ==============================================================================
# MangaTranslator Configuration Environment
# ==============================================================================

# Translation Providers (set the API key for your chosen provider)
GOOGLE_API_KEY=your_google_or_gemini_api_key_here
GEMINI_API_KEY=your_google_or_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Local / OpenAI Compatible Endpoints (e.g., vLLM, Ollama, LM Studio)
OPENAI_COMPATIBLE_URL=http://localhost:8080/v1
OPENAI_COMPATIBLE_API_KEY=

# Hugging Face Access Token (optional, for gated OCR/detection weights)
HUGGINGFACE_TOKEN=
